generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Accounts & auth (Auth.js / NextAuth Prisma adapter) ─────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("BUYER") // BUYER | VENDOR | ADMIN
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  vendor       Vendor?
  compositions Composition[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Vendors & their listings ────────────────────────────────────────────────
model Vendor {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  contactEmail String?
  phone        String?
  city         String?
  createdAt    DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Supplier[]
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  category     String // VENUE | CATERER | PRODUCTION | PHOTOGRAPHER | FLORIST
  price        Int? // fixed price, null for caterers
  perHead      Int? // caterers only
  capacity     Int? // venues only
  kitchen      Boolean? // venues
  rigging      Boolean? // venues
  stepFree     Boolean? // venues
  halal        Boolean? // caterers
  needsKitchen Boolean? // caterers
  needsRigging Boolean? // production
  staging      Boolean? // production
  recPct       Int // delivered-as-agreed %
  recEvents    Int // count of client-confirmed events

  status   String  @default("published") // draft | published
  vendorId String? // null for seeded demo suppliers
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  blackouts Blackout[]
}

// A date a listing is not available (replaces the pseudo-availability hash once
// vendors start managing their own calendars).
model Blackout {
  id         String   @id @default(cuid())
  supplierId String
  date       String // YYYY-MM-DD
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, date])
}

model Composition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  brief     String // the submitted brief, JSON-serialised (SQLite has no Json type)
  teams     String // the solved teams, JSON-serialised
  reference String? // set on confirmation, e.g. EV-48213
  status    String   @default("composed") // composed | confirmed

  userId String? // the buyer, once accounts exist
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}
