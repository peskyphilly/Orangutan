generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Accounts & password sessions ────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String? // required for new accounts; null only for pre-password legacy rows
  role         String   @default("BUYER") // BUYER | VENDOR | ADMIN
  createdAt    DateTime @default(now())

  sessions     Session[]
  vendor       Vendor?
  compositions Composition[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Vendors & their listings ────────────────────────────────────────────────
model Vendor {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  contactEmail String?
  phone        String?
  city         String?
  createdAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings  Supplier[]
  enquiries Enquiry[]
}

// An enquiry a vendor receives when a buyer confirms a team containing one of
// their listings. This is the demo's booking loop — buyer confirm → vendor sees it.
model Enquiry {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  compositionId String
  reference     String
  vendorId      String
  supplierId    String
  listingName   String
  role          String
  occasion      String
  eventDate     String
  guests        Int
  amount        Int
  status        String   @default("new") // new | accepted | declined

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  category     String // VENUE | CATERER | PRODUCTION | PHOTOGRAPHER | FLORIST
  price        Int? // fixed price, null for caterers
  perHead      Int? // caterers only
  capacity     Int? // venues only
  kitchen      Boolean? // venues
  rigging      Boolean? // venues
  stepFree     Boolean? // venues
  halal        Boolean? // caterers
  needsKitchen Boolean? // caterers
  needsRigging Boolean? // production
  staging      Boolean? // production
  recPct       Int // delivered-as-agreed %
  recEvents    Int // count of client-confirmed events

  status   String  @default("published") // draft | published
  vendorId String? // null for seeded demo suppliers
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  blackouts Blackout[]
}

// A date a listing is not available.
// reason = "vendor"  → set by the supplier (editable/removable)
// reason = "booking" → set when a buyer confirms a team (locked; vendors cannot clear)
model Blackout {
  id         String   @id @default(cuid())
  supplierId String
  date       String // YYYY-MM-DD
  reason     String   @default("vendor") // vendor | booking
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, date])
}

model Composition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  brief     String // the submitted brief, JSON-serialised (SQLite has no Json type)
  teams     String // the solved teams, JSON-serialised
  reference String? @unique // set on confirmation, e.g. EV-48213
  status    String  @default("composed") // composed | confirmed

  userId String? // the buyer who owns this composition
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}
