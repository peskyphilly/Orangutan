// Production schema — identical models to schema.prisma, but on PostgreSQL for a
// hosted deploy (Vercel serverless can't persist a SQLite file). Local dev and
// the test suite keep using the SQLite schema.prisma; only the Vercel build
// (`npm run build:vercel`) points Prisma at this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  role         String   @default("BUYER")
  createdAt    DateTime @default(now())

  sessions     Session[]
  vendor       Vendor?
  compositions Composition[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  contactEmail String?
  phone        String?
  city         String?
  createdAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings  Supplier[]
  enquiries Enquiry[]
}

model Enquiry {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  compositionId String
  reference     String
  vendorId      String
  supplierId    String
  listingName   String
  role          String
  occasion      String
  eventDate     String
  guests        Int
  amount        Int
  status        String   @default("new")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  category     String
  price        Int?
  perHead      Int?
  capacity     Int?
  kitchen      Boolean?
  rigging      Boolean?
  stepFree     Boolean?
  halal        Boolean?
  needsKitchen Boolean?
  needsRigging Boolean?
  staging      Boolean?
  recPct       Int
  recEvents    Int

  status   String  @default("published")
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  blackouts Blackout[]
}

model Blackout {
  id         String   @id @default(cuid())
  supplierId String
  date       String
  reason     String   @default("vendor") // vendor | booking
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, date])
}

model Composition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  brief     String
  teams     String
  reference String?  @unique
  status    String   @default("composed")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
