# Local development uses SQLite (zero infra):
DATABASE_URL="file:./dev.db"

# For a hosted Vercel deploy, set DATABASE_URL to a PostgreSQL connection string
# instead — e.g. a free database from https://neon.tech. Use the direct (non-pooled)
# connection string with sslmode=require, for example:
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/eventos?sslmode=require"
